<Window x:Class="ScreenRecorder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/App.ico" Title="Configurações" Width="560" SizeToContent="Height" MinHeight="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="7,5"/><Setter Property="MinHeight" Value="32"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,20,7"/></Style>
    </Window.Resources>
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
            <Border Height="1" Background="#DDE3ED" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" MinWidth="88" Margin="0,0,10,0"/>
                <Button Content="Salvar" IsDefault="True" MinWidth="88" Click="SaveClick" Background="#2162D5" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>

            <StackPanel>
                <TextBlock Text="Configurações" FontSize="23" FontWeight="SemiBold" Foreground="#17243A" Margin="0,0,0,18"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Formato" Margin="0,0,0,5"/><ComboBox x:Name="FormatBox"><ComboBoxItem Content="MP4"/><ComboBoxItem Content="MKV"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Codec" Margin="0,0,0,5"/><ComboBox x:Name="CodecBox"><ComboBoxItem Content="H.264"/><ComboBoxItem Content="H.265"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Quadros/s" Margin="0,0,0,5"/><ComboBox x:Name="FpsBox"><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/></ComboBox></StackPanel>
                </Grid>
                <TextBlock Text="H.265 depende de um codificador HEVC disponível no PC." Foreground="#526079" FontSize="11" Margin="0,8,0,18" TextWrapping="Wrap"/>
                <TextBlock Text="ÁUDIO" FontWeight="SemiBold" Foreground="#526079"/>
                <WrapPanel><CheckBox x:Name="SystemAudioCheck" Content="Áudio do PC"/><CheckBox x:Name="MicrophoneCheck" Content="Microfone"/></WrapPanel>
                <TextBlock Text="Usa os dispositivos padrão do Windows." Foreground="#526079" FontSize="11" Margin="0,0,0,18"/>
                <TextBlock Text="MOUSE" FontWeight="SemiBold" Foreground="#526079"/>
                <WrapPanel Margin="0,0,0,18"><CheckBox x:Name="RecordMouseCheck" Content="Gravar cursor"/><CheckBox x:Name="HighlightMouseCheck" Content="Realçar em amarelo"/></WrapPanel>
                <TextBlock Text="SALVAR EM" FontWeight="SemiBold" Foreground="#526079" Margin="0,0,0,7"/>
                <DockPanel><Button Content="Escolher…" Click="ChooseFolderClick" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="FolderText" IsReadOnly="True" VerticalContentAlignment="Center" Padding="7" ToolTip="Pasta das gravações"/></DockPanel>
                <TextBlock Text="ATALHOS GLOBAIS" FontWeight="SemiBold" Foreground="#526079" Margin="0,20,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                    <TextBlock Text="Iniciar gravação" VerticalAlignment="Center"/>
                    <TextBox x:Name="StartShortcutBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="CaptureShortcut" VerticalContentAlignment="Center" Padding="8,4" Margin="0,3" ToolTip="Clique e pressione o atalho desejado"/>
                    <TextBlock Text="Pausar / retomar" Grid.Row="1" VerticalAlignment="Center"/>
                    <TextBox x:Name="PauseShortcutBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="CaptureShortcut" VerticalContentAlignment="Center" Padding="8,4" Margin="0,3" ToolTip="Clique e pressione o atalho desejado"/>
                    <TextBlock Text="Finalizar" Grid.Row="2" VerticalAlignment="Center"/>
                    <TextBox x:Name="StopShortcutBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="CaptureShortcut" VerticalContentAlignment="Center" Padding="8,4" Margin="0,3" ToolTip="Clique e pressione o atalho desejado"/>
                </Grid>
                <TextBlock Text="Clique no campo e pressione a combinação. Use Ctrl/Alt ou uma tecla F1–F24. Backspace ou Delete desativa o atalho." Foreground="#526079" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>            </StackPanel>

    </DockPanel>
</Window>
